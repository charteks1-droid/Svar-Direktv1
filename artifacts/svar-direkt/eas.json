{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "JAVA_TOOL_OPTIONS": "-XX:+IgnoreUnrecognizedVMOptions"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "JAVA_TOOL_OPTIONS": "-XX:+IgnoreUnrecognizedVMOptions"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
